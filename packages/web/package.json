{
  "name": "@cfp-help/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply cfp-help-db --local",
    "db:studio": "drizzle-kit studio",
    "pages:dev": "wrangler pages dev --compatibility-date=2024-01-01 -- pnpm dev",
    "pages:deploy": "pnpm build && wrangler pages deploy .vercel/output/static"
  },
  "dependencies": {
    "@cfp-help/core": "workspace:*",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tanstack/react-query": "^5.62.7",
    "@trpc/client": "next",
    "@trpc/react-query": "next",
    "@trpc/server": "next",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250106.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "wrangler": "^3.104.0"
  }
}
