{
  "name": "cfp_help",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/index.ts",
    "start": "bun dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "format": "bunx @biomejs/biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["cfp", "conference", "cli", "llm", "proposal-generation"],
  "author": "",
  "license": "ISC",
  "description": "CFP proposal generation CLI tool for conferences",
  "type": "module",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "openai": "^5.12.2",
    "p-limit": "^6.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.2.1",
    "typescript": "^5.9.2"
  },
  "bin": {
    "cfp-help": "dist/index.js"
  }
}
