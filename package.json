{
  "name": "cfp_help",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.cli.json",
    "build:web": "next build",
    "dev": "bun run src/index.ts",
    "dev:web": "next dev",
    "start": "bun dist/index.js",
    "start:web": "next start",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx @biomejs/biome check .",
    "lint:next": "next lint",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "format": "bunx @biomejs/biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cfp",
    "conference",
    "cli",
    "llm",
    "proposal-generation"
  ],
  "author": "",
  "license": "ISC",
  "description": "CFP proposal generation CLI tool for conferences",
  "type": "module",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tanstack/react-query": "^5.60.0",
    "@trpc/client": "^11.0.0-rc.682",
    "@trpc/next": "^11.0.0-rc.682",
    "@trpc/react-query": "^11.0.0-rc.682",
    "@trpc/server": "^11.0.0-rc.682",
    "ai": "^4.0.0",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "next": "^15.0.3",
    "openai": "^5.12.2",
    "p-limit": "^6.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "superjson": "^2.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.2"
  },
  "bin": {
    "cfp-help": "dist/index.js"
  }
}
