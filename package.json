{
  "name": "cfp-help-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev:core": "pnpm --filter @cfp-help/core dev",
    "dev:cli": "pnpm --filter @cfp-help/cli dev",
    "dev:web": "pnpm --filter @cfp-help/web dev",
    "build:core": "pnpm --filter @cfp-help/core build",
    "build:cli": "pnpm --filter @cfp-help/cli build",
    "build:web": "pnpm --filter @cfp-help/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @cfp-help/core test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=18"
  },
  "keywords": ["cfp", "conference", "cli", "llm", "proposal-generation"],
  "author": "",
  "license": "ISC",
  "description": "CFP proposal generation tool for conferences (CLI & Web)"
}
